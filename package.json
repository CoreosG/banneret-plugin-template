    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm conformance"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "oxlint": "1.95.0",
    "typescript": "~5.9.3",
    "yaml": "2.9.0"
  }
}
